# Database configuration
APP_DATABASE__HOST=postgres
APP_DATABASE__PORT=5432
APP_DATABASE__USER=payment_user
APP_DATABASE__PASSWORD=payment_password
APP_DATABASE__DBNAME=payment_DB
APP_DATABASE__SSLMODE=disable
APP_DATABASE__MIGRATIONS_PATH=./migrations
# Migrations
MIGRATION_AS_SERVICE=true
# Logger configuration
APP_LOGGER__LEVEL=debug
# Server configuration
APP_SERVER__PORT=8080
# Kafka
APP_KAFKA__BROKERS=kafka:9092
APP_KAFKA__ACKS=all
APP_KAFKA__CLIENT_ID=payment-service
APP_KAFKA__TOPIC=payments
# Relay
APP_RELAY__WORKER_COUNT=4
APP_RELAY__BATCH_SIZE=2
APP_RELAY__POLL_INTERVAL=1s
APP_RELAY__MAX_ATTEMPTS=5
APP_RELAY__BASE_DELAY=1
APP_RELAY__MAX_DELAY=30
APP_RELAY__JITTER_PERCENT=30
# Redis
APP_REDIS__ADDR=redis:6379
APP_REDIS__PASSWORD=
APP_REDIS__USER=
APP_REDIS__DB=0
APP_REDIS__MAX_RETRIES=3
APP_REDIS__DIAL_TIMEOUT=5s
APP_REDIS__TIMEOUT=3s
APP_REDIS__READ_TIMEOUT=3s
APP_REDIS__WRITE_TIMEOUT=3s