# Database configuration
APP_DATABASE_HOST=localhost
APP_DATABASE_PORT=5432
APP_DATABASE_USER=payment_user
APP_DATABASE_PASSWORD=payment_password
APP_DATABASE_DBNAME=payment_DB
APP_DATABASE_SSLMODE=disable
APP_DATABASE_MIGRATIONS_PATH=./migrations

# Logger configuration
APP_LOGGER_LEVEL=debug

# Server configuration
APP_SERVER_PORT=8080

# Kafka
APP_KAFKA_BOOTSTRAPSERVERS=localhost:9092
APP_KAFKA_ACKS=all
APP_KAFKA_CLIENTID=payment-service
APP_KAFKA_BROKERS=localhost:9092
APP_KAFKA_TOPIC=payments

# Relay
APP_RELAY_WOKERCOUNT=4
APP_RELAY_BATCHSIZE=2
APP_RELAY_POLLINTERVAL=1
APP_RELAY_MAXATTEMPTS=5
APP_RELAY_BASEDELAY=1
APP_RELAY_MAXDELAY=30
APP_RELAY_JITTERPERCENT=30