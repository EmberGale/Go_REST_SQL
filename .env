# Database configuration
APP_DATABASE_HOST=postgres
APP_DATABASE_PORT=5432
APP_DATABASE_USER=payment_user
APP_DATABASE_PASSWORD=payment_password
APP_DATABASE_DBNAME=payment_DB
APP_DATABASE_SSLMODE=disable
APP_DATABASE_MIGRATIONS_PATH=./app/migrations

# Migrations
MIGRATION_AS_SERVICE=true

# Logger configuration
APP_LOGGER_LEVEL=debug

# Server configuration
APP_SERVER_PORT=8080

# Kafka
APP_KAFKA_BROKERS=kafka:9092
APP_KAFKA_ACKS=all
APP_KAFKA_CLIENT_ID=payment-service
APP_KAFKA_TOPIC=payments

# Relay
APP_RELAY_WORKER_COUNT=4
APP_RELAY_BATCH_SIZE=2
APP_RELAY_POLL_INTERVAL=1s
APP_RELAY_MAX_ATTEMPTS=5
APP_RELAY_BASE_DELAY=1
APP_RELAY_MAX_DELAY=30
APP_RELAY_JITTER_PERCENT=30